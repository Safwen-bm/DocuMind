generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  id                 String    @id @default(uuid())
  nom                String
  email              String    @unique
  motDePasse         String
  avatarUrl          String?
  estActif           Boolean   @default(false)
  tentativesEchec    Int       @default(0)
  verrouillageJusqua DateTime?
  dateCreation       DateTime  @default(now())
  dateMiseAJour      DateTime  @updatedAt

  workspacesOwned Workspace[]         @relation("WorkspaceProprietaire")
  tokens          TokenVerification[]
  memberships     MembreWorkspace[]
  documents       Document[]
  versions        VersionDocument[]
  activites       Activite[]
  notifications   Notification[]
  conversations   Conversation[]
  shareTokens     ShareToken[]
  commentaires    Commentaire[]
  documentViews   DocumentView[]
  favoris         DocumentFavori[]

  @@map("utilisateurs")
}

model TokenVerification {
  id            String    @id @default(uuid())
  utilisateurId String
  token         String    @unique
  type          TokenType
  expiration    DateTime
  dateCreation  DateTime  @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@map("tokens_verification")
}

enum TokenType {
  CONFIRMATION_EMAIL
  RESET_MOT_DE_PASSE
  OTP_2FA
}

model Workspace {
  id             String      @id @default(uuid())
  nom            String
  proprietaireId String
  proprietaire   Utilisateur @relation("WorkspaceProprietaire", fields: [proprietaireId], references: [id])
  description    String?
  logoUrl        String?
  dateCreation   DateTime    @default(now())
  dateMiseAJour  DateTime    @updatedAt
  subscription  Subscription?

  membres       MembreWorkspace[]
  invitations   Invitation[]
  dossiers      Dossier[]
  documents     Document[]
  activites     Activite[]
  notifications Notification[]
  conversations Conversation[]

  @@unique([proprietaireId, nom])
  @@map("workspaces")
}

model MembreWorkspace {
  id            String   @id @default(uuid())
  utilisateurId String
  workspaceId   String
  role          Role
  dateAdhesion  DateTime @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, workspaceId])
  @@map("membres_workspace")
}

enum Role {
  LECTEUR
  EDITEUR
  ADMINISTRATEUR
  PROPRIETAIRE
}

model Invitation {
  id           String   @id @default(uuid())
  email        String
  workspaceId  String
  token        String   @unique
  role         Role     @default(LECTEUR)
  expiration   DateTime
  dateCreation DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

model Dossier {
  id           String   @id @default(uuid())
  nom          String
  workspaceId  String
  parentId     String?
  createdById  String?
  dateCreation DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Dossier?   @relation("DossierEnfants", fields: [parentId], references: [id], onDelete: Cascade)
  enfants   Dossier[]  @relation("DossierEnfants")
  documents Document[]

  @@unique([workspaceId, parentId, nom])
  @@map("dossiers")
}

model Document {
  id            String   @id @default(uuid())
  titre         String   @default("Sans titre")
  contenu       Json?
  workspaceId   String
  dossierId     String?
  authorId      String
  estArchive    Boolean  @default(false)
  estIndexe     Boolean  @default(false)
  tags          String[] @default([])
  dateCreation  DateTime @default(now())
  dateMiseAJour DateTime @updatedAt

  chunks        DocumentChunk[]
  conversations Conversation[]
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dossier       Dossier?          @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  author        Utilisateur       @relation(fields: [authorId], references: [id])
  versions      VersionDocument[]
  shareTokens   ShareToken[]
  commentaires  Commentaire[]
  views         DocumentView[]
  favoris       DocumentFavori[]

  @@unique([workspaceId, dossierId, titre])
  @@map("documents")
}

// ── NEW: Document read tracking ───────────────────────────────────────────────
model DocumentView {
  id           String   @id @default(uuid())
  documentId   String
  userId       String
  lastViewedAt DateTime @default(now())

  document Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId]) // one record per user per document, updated on each view
  @@map("document_views")
}

model VersionDocument {
  id           String   @id @default(uuid())
  documentId   String
  contenu      Json
  numero       Int
  createdById  String
  dateCreation DateTime @default(now())

  document  Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy Utilisateur @relation(fields: [createdById], references: [id])

  @@map("versions_document")
}

model DocumentChunk {
  id           String                      @id @default(uuid())
  documentId   String
  contenu      String
  embedding    Unsupported("vector(3072)")
  chunkIndex   Int
  dateCreation DateTime                    @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_chunks")
}

model Commentaire {
  id            String   @id @default(uuid())
  contenu       String
  documentId    String
  auteurId      String
  estResolu     Boolean  @default(false)
  dateCreation  DateTime @default(now())
  dateMiseAJour DateTime @updatedAt

  document Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  auteur   Utilisateur @relation(fields: [auteurId], references: [id], onDelete: Cascade)

  @@map("commentaires")
}

model Conversation {
  id            String   @id @default(uuid())
  utilisateurId String
  workspaceId   String
  documentId    String?
  titre         String   @default("New conversation")
  dateCreation  DateTime @default(now())
  dateMiseAJour DateTime @updatedAt

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document    Document?   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  messages    MessageIA[]

  @@map("conversations")
}

model MessageIA {
  id             String   @id @default(uuid())
  conversationId String
  role           RoleIA
  contenu        String
  sources        Json?
  dateCreation   DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages_ia")
}

enum RoleIA {
  UTILISATEUR
  ASSISTANT
}

model Activite {
  id           String     @id @default(uuid())
  workspaceId  String
  userId       String
  action       ActionType
  cible        String
  cibleId      String?
  dateCreation DateTime   @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activites")
}

enum ActionType {
  DOCUMENT_CREE
  DOCUMENT_MODIFIE
  DOCUMENT_SUPPRIME
  DOCUMENT_FAVORI
  DOSSIER_CREE
  DOSSIER_SUPPRIME
  MEMBRE_INVITE
  MEMBRE_REJOINT
  VERSION_RESTAUREE
}

model Notification {
  id           String           @id @default(uuid())
  userId       String
  workspaceId  String?
  type         NotificationType
  message      String
  lu           Boolean          @default(false)
  lien         String?
  dateCreation DateTime         @default(now())

  user      Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum NotificationType {
  INVITATION
  MENTION
  DOCUMENT_PARTAGE
  MEMBRE_REJOINT
  COMMENTAIRE
  NOUVEAU_DOCUMENT
  DOCUMENT_MODIFIE
  ROLE_MODIFIE
  MEMBRE_RETIRE
  SYSTEME
}

model DocumentFavori {
  utilisateurId String
  documentId    String
  dateAjout     DateTime @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  document    Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([utilisateurId, documentId])
  @@map("document_favoris")
}

model ShareToken {
  id           String          @id @default(uuid())
  token        String          @unique
  documentId   String
  createdById  String
  permission   SharePermission @default(READ)
  expiresAt    DateTime?
  dateCreation DateTime        @default(now())

  document  Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy Utilisateur @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("share_tokens")
}

enum SharePermission {
  READ
  EDIT
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

model Subscription {
  id                   String    @id @default(uuid())
  workspaceId          String    @unique
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  plan                 Plan      @default(FREE)
  status               String    @default("active")
  currentPeriodEnd     DateTime?
  dateCreation         DateTime  @default(now())
  dateMiseAJour        DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model AiUsage {
  id            String   @id @default(uuid())
  userId        String
  workspaceId   String
  date          String
  count         Int      @default(0)
  dateCreation  DateTime @default(now())
  dateMiseAJour DateTime @updatedAt

  @@unique([userId, workspaceId, date])
  @@map("ai_usage")
}
