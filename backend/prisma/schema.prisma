generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  id                  String    @id @default(uuid())
  nom                 String
  email               String    @unique
  motDePasse          String
  avatarUrl           String?
  estActif            Boolean   @default(false)
  tentativesEchec     Int       @default(0)
  verrouillageJusqua  DateTime?
  dateCreation        DateTime  @default(now())
  dateMiseAJour       DateTime  @updatedAt

  tokens              TokenVerification[]
  memberships         MembreWorkspace[]
  documents           Document[]
  versions            VersionDocument[]
  activites           Activite[]
  notifications       Notification[]

  @@map("utilisateurs")
}

model TokenVerification {
  id             String    @id @default(uuid())
  utilisateurId  String
  token          String    @unique
  type           TokenType
  expiration     DateTime
  dateCreation   DateTime  @default(now())

  utilisateur    Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@map("tokens_verification")
}

enum TokenType {
  CONFIRMATION_EMAIL
  RESET_MOT_DE_PASSE
  OTP_2FA
}

model Workspace {
  id             String    @id @default(uuid())
  nom            String
  proprietaireId String
  description    String?
  logoUrl        String?
  dateCreation   DateTime  @default(now())
  dateMiseAJour  DateTime  @updatedAt

  membres        MembreWorkspace[]
  invitations    Invitation[]
  dossiers       Dossier[]
  documents      Document[]
  activites      Activite[]
  notifications  Notification[]

  @@map("workspaces")
}

model MembreWorkspace {
  id             String   @id @default(uuid())
  utilisateurId  String
  workspaceId    String
  role           Role
  dateAdhesion   DateTime @default(now())

  utilisateur    Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, workspaceId])
  @@map("membres_workspace")
}

enum Role {
  LECTEUR
  EDITEUR
  ADMINISTRATEUR
  PROPRIETAIRE
}

model Invitation {
  id           String    @id @default(uuid())
  email        String
  workspaceId  String
  token        String    @unique
  role         Role      @default(LECTEUR)
  expiration   DateTime
  dateCreation DateTime  @default(now())

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

model Dossier {
  id           String    @id @default(uuid())
  nom          String
  workspaceId  String
  parentId     String?
  createdById  String?
  dateCreation DateTime  @default(now())

  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent       Dossier?   @relation("DossierEnfants", fields: [parentId], references: [id], onDelete: Cascade)
  enfants      Dossier[]  @relation("DossierEnfants")
  documents    Document[]

  @@map("dossiers")
}

model Document {
  id           String    @id @default(uuid())
  titre        String    @default("Sans titre")
  contenu      Json?
  workspaceId  String
  dossierId    String?
  authorId     String
  estFavori    Boolean   @default(false)
  estArchive   Boolean   @default(false)
  dateCreation DateTime  @default(now())
  dateMiseAJour DateTime @updatedAt

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dossier      Dossier?        @relation(fields: [dossierId], references: [id], onDelete: SetNull)
  author       Utilisateur     @relation(fields: [authorId], references: [id])
  versions     VersionDocument[]

  @@map("documents")
}

model VersionDocument {
  id           String    @id @default(uuid())
  documentId   String
  contenu      Json
  numero       Int
  createdById  String
  dateCreation DateTime  @default(now())

  document     Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy    Utilisateur @relation(fields: [createdById], references: [id])

  @@map("versions_document")
}

model Activite {
  id           String       @id @default(uuid())
  workspaceId  String
  userId       String
  action       ActionType
  cible        String
  cibleId      String?
  dateCreation DateTime     @default(now())

  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activites")
}

enum ActionType {
  DOCUMENT_CREE
  DOCUMENT_MODIFIE
  DOCUMENT_SUPPRIME
  DOCUMENT_FAVORI
  DOSSIER_CREE
  DOSSIER_SUPPRIME
  MEMBRE_INVITE
  MEMBRE_REJOINT
  VERSION_RESTAUREE
}

model Notification {
  id           String           @id @default(uuid())
  userId       String
  workspaceId  String?
  type         NotificationType
  message      String
  lu           Boolean          @default(false)
  lien         String?
  dateCreation DateTime         @default(now())

  user         Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum NotificationType {
  INVITATION
  MENTION
  DOCUMENT_PARTAGE
  MEMBRE_REJOINT
  SYSTEME
}